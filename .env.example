# SkillMatch Frontend Environment Configuration
#
# Local development:
# Leave VITE_API_URL empty or unset. Vite dev server proxies /api to http://127.0.0.1:8000
#
# Production (e.g. Vercel Project Settings -> Environment Variables):
# Set VITE_API_URL to your deployed FastAPI backend URL:
VITE_API_URL=

