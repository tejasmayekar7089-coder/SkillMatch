# SkillMatch Backend Configuration

# Database
# Local SQLite for development
DATABASE_URL=sqlite:///./skillmatch.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillmatch

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS: Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# App Environment
ENVIRONMENT=development
PROJECT_NAME="SkillMatch API"
DEBUG=True
