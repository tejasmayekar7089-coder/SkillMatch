# SkillMatch Backend Environment Configuration

# App & Environment
PROJECT_NAME="SkillMatch API"
ENVIRONMENT=production
DEBUG=False

# Database
# Local SQLite for development:
# DATABASE_URL=sqlite:///./skillmatch.db
# Production PostgreSQL (Supabase / Neon / Render / Railway):
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/skillmatch

# Security (Generate a secure 32+ char random string: openssl rand -hex 32)
SECRET_KEY=generate-a-secure-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: Comma-separated list of allowed frontend origins (NO trailing slashes)
CORS_ORIGINS=https://skillmatch.vercel.app,https://your-custom-domain.com,http://localhost:5173

# Embedding Model (CPU ONNX sentence-transformer)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Optional LLM API Keys (for live AI Advisor reasoning)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
